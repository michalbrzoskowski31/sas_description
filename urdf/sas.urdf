<?xml version="1.0"?>
<robot name="sas">

    <link name="world"/>

    <joint name="world_to_base_joint" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </joint>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://sas_description/meshes/base_link.stl" scale="0.01 0.01 0.01"/>
            </geometry>
            <material name="gray">
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
    </link>

    <joint name="carriage_joint" type="prismatic">
        <parent link="base_link"/>
        <child link="carriage_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.464" upper="2.033" effort="100.0" velocity="0.5"/>
    </joint>

    <link name="carriage_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://sas_description/meshes/carriage_link.stl" scale="0.01 0.01 0.01"/>
            </geometry>
            <material name="blue">
                <color rgba="0.1 0.3 0.8 1.0"/>
            </material>
        </visual>
    </link>

    <joint name="drill_joint" type="fixed">
        <parent link="carriage_link"/>
        <child link="drill_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="drill_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://sas_description/meshes/drill_link.stl" scale="0.01 0.01 0.01"/>
            </geometry>
            <material name="silver">
                <color rgba="0.8 0.8 0.8 1.0"/>
            </material>
        </visual>
    </link>

</robot>